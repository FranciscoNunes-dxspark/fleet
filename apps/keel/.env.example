# Copy to .env and fill in. Without AZDO_ORG_URL and AZDO_PAT the app runs on demo data.

# Azure DevOps Services: https://dev.azure.com/<org>
# Azure DevOps Server:   https://tfs.example.com/tfs/<Collection>
AZDO_ORG_URL=https://dev.azure.com/your-org

# Personal access token. Scopes needed (see README):
#   Code: Read & write · Work Items: Read & write · Build: Read & execute
#   Release: Read, write, execute & manage (classic releases and approvals)
#   Project and Team: Read · Identity: Read
AZDO_PAT=

# Optional: projects to track on first run (comma separated). You can change this later in Settings.
AZDO_PROJECTS=

# ---- Hosting for a team (sign-in with each person's own PAT) ----
# AUTH_MODE=login          # each person signs in with their own PAT; leave AZDO_PAT empty
# SESSION_SECRET=          # 32+ random characters, e.g. from: openssl rand -hex 32
# ALLOWED_HOSTS=console.example.com
# TRUST_PROXY=1            # behind nginx / Hostinger's proxy, so HTTPS and client IPs are seen
# SESSION_DAYS=7           # sign-in lasts this long (sliding, 30 days maximum)

# Optional
# API_PORT=4280
# HOST=127.0.0.1
# AZDO_API_VERSION=7.1
# AZDO_MAX_CONCURRENCY=6
# AZDO_MOCK=1
