# Copy to .env and fill in. Without AZDO_ORG_URL and AZDO_PAT the app runs on demo data.

# Azure DevOps Services: https://dev.azure.com/<org>
# Azure DevOps Server:   https://tfs.example.com/tfs/<Collection>
AZDO_ORG_URL=https://dev.azure.com/your-org

# Personal access token. Scopes needed (see README):
#   Code: Read & write · Work Items: Read & write · Build: Read & execute
#   Release: Read, write, execute & manage (classic releases and approvals)
#   Project and Team: Read · Identity: Read
AZDO_PAT=
# Or no PAT: AZDO_AUTH=az uses your Azure CLI sign-in (az login) instead. The terminal app (npm run cli) does this by itself.
# AZDO_AUTH=az

# Optional: projects to track on first run (comma separated). You can change this later in Settings.
AZDO_PROJECTS=

# GitHub owners added in Settings → Organizations (pull requests and Actions), in local mode and the terminal app.
# Scopes: repo + workflow (classic), or fine-grained Contents, Pull requests, Actions, Checks, Deployments (read and write).
# Without it, Keel uses your GitHub CLI sign-in (gh auth login).
# GITHUB_TOKEN=

# ---- Hosting for a team (accounts with roles, each person links their own PAT) ----
# AUTH_MODE=login          # email + password accounts (Admin, Developer, PM); leave AZDO_PAT empty
# SESSION_SECRET=          # 32+ random characters, e.g. from: openssl rand -hex 32
# ADMIN_SETUP_CODE=        # code to create the first admin; if unset, one is printed in the server log
# PUBLIC_URL=https://keel.example.com  # where Keel is published: its host is allowed, and Teams/Slack posts link here
# PUSH_SUBJECT=mailto:you@example.com  # who push services can contact about this server's notifications (default: PUBLIC_URL)
# PUSH_ALLOW_HOSTS=                    # extra push service hosts, comma-separated (the major browsers' are built in)
# ALLOWED_HOSTS=www.keel.example.com    # any other host names it's reached by (comma separated)
# TRUST_PROXY=1            # behind nginx / Hostinger's proxy, so HTTPS and client IPs are seen
# SESSION_DAYS=7           # sign-in lasts this long (sliding, 30 days maximum)

# Optional
# DATA_DIR=/var/lib/keel    # where accounts and settings are stored (default: data/, or next to Hostinger's hbuilds)
# MONITOR_ALLOW_PRIVATE=1   # allow production monitors (and channel webhooks) on private/internal addresses
# API_PORT=4280
# HOST=127.0.0.1
# AZDO_API_VERSION=7.1
# AZDO_MAX_CONCURRENCY=6
# AZDO_MOCK=1
