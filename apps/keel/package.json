{
  "name": "keel",
  "version": "0.1.28",
  "private": true,
  "homepage": "https://keel.example.com",
  "description": "Keel: a tech lead's console for Azure DevOps. PRs, work items, boards, pipelines and releases across projects and repos.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "keel": "bin/keel.js"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"node --watch-path=server server/index.js\" \"vite\"",
    "dev:mock": "concurrently -k -n api,web -c blue,magenta \"node --watch-path=server server/index.js --mock\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "start:mock": "node server/index.js --mock",
    "cli": "node bin/keel.js",
    "cli:demo": "node bin/keel.js --demo",
    "build:cli": "npx --yes bun@1.4.2 ../../packages/kit/scripts/build.js",
    "build:android": "node scripts/build-android.mjs",
    "test": "node --import @fleet/kit/register.js --import ./cli/app.js --test \"test/**/*.test.js\"",
    "postinstall": "patch-package --patch-dir ../../patches || exit 0"
  },
  "dependencies": {
    "@fleet/kit": "file:../../packages/kit",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "chalk": "^5.6.2",
    "dompurify": "^3.4.17",
    "express": "^5.3.0",
    "ink": "^6.8.0",
    "marked": "^18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "vite": "^8.3.4"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "ink-testing-library": "^4.0.0",
    "patch-package": "^8.0.1"
  },
  "fleet": {
    "app": "cli/app.js",
    "entry": "cli/cli.jsx",
    "out": "release",
    "compile": {
      "autoloadDotenv": false,
      "autoloadBunfig": false
    }
  }
}
