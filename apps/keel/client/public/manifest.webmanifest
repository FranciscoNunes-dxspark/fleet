{
  "name": "Keel",
  "short_name": "Keel",
  "description": "A tech lead's console for Azure DevOps: pull requests, work items, pipelines and production.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#121314",
  "theme_color": "#121314",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Inbox", "url": "/inbox", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Production", "url": "/production", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Pull requests", "url": "/prs", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
