{
  "name": "lookout",
  "version": "0.1.0",
  "private": true,
  "description": "A local HTTP and HTTPS proxy that records what a browser, an emulator or your own server sends and receives, and hands any request to Hail as a .http file",
  "type": "module",
  "bin": {
    "lookout": "bin/lookout.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node bin/lookout.js",
    "demo": "node bin/lookout.js --demo",
    "test": "node --import @fleet/kit/register.js --import ./src/app.js --test --test-concurrency=3 test/*.test.js",
    "build": "npx --yes bun@1.4.2 ../../packages/kit/scripts/build.js",
    "build:all": "npx --yes bun@1.4.2 ../../packages/kit/scripts/build.js --all"
  },
  "license": "MIT",
  "dependencies": {
    "@fleet/kit": "file:../../packages/kit",
    "ink": "^6.8.0",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "ink-testing-library": "^4.0.0"
  }
}
