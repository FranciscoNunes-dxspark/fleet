{
  "name": "trawl",
  "version": "0.1.26",
  "private": true,
  "description": "A keyboard-driven SQL Server client for the terminal",
  "type": "module",
  "bin": {
    "trawl": "bin/trawl.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node bin/trawl.js",
    "demo": "node bin/trawl.js --demo",
    "test": "node --import @fleet/kit/register.js --import ./src/app.js --test test/*.test.js",
    "build": "npx --yes bun@1.4.2 ../../packages/kit/scripts/build.js",
    "build:all": "npx --yes bun@1.4.2 ../../packages/kit/scripts/build.js --all"
  },
  "license": "MIT",
  "dependencies": {
    "@fleet/kit": "file:../../packages/kit",
    "ink": "^6.8.0",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "tedious": "^20.3.8"
  },
  "devDependencies": {
    "ink-testing-library": "^4.0.0"
  }
}
