{
  "name": "helm",
  "version": "0.1.0",
  "private": true,
  "description": "A PowerShell script editor in the terminal, like the ISE: a script pane, a console and an output pane over one PowerShell session",
  "type": "module",
  "bin": {
    "helm": "bin/helm.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node bin/helm.js",
    "test": "node --import @fleet/kit/register.js --import ./src/app.js --test --test-concurrency=3 test/*.test.js",
    "build": "npx --yes bun@1.4.2 ../../packages/kit/scripts/build.js",
    "build:all": "npx --yes bun@1.4.2 ../../packages/kit/scripts/build.js --all"
  },
  "license": "MIT",
  "dependencies": {
    "@fleet/kit": "file:../../packages/kit",
    "ink": "^6.8.0",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "ink-testing-library": "^4.0.0"
  }
}
