{
  "name": "wharf",
  "version": "0.1.0",
  "private": true,
  "description": "Containers in the terminal: what's running, its logs, and starting, stopping and removing it",
  "type": "module",
  "bin": {
    "wharf": "bin/wharf.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node bin/wharf.js",
    "demo": "node bin/wharf.js --demo",
    "test": "node --import @fleet/kit/register.js --import ./src/app.js --test --test-concurrency=3 test/*.test.js",
    "build": "npx --yes bun@1.4.2 ../../packages/kit/scripts/build.js",
    "build:all": "npx --yes bun@1.4.2 ../../packages/kit/scripts/build.js --all"
  },
  "license": "MIT",
  "dependencies": {
    "@fleet/kit": "file:../../packages/kit",
    "ink": "^6.8.0",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "ink-testing-library": "^4.0.0"
  }
}
