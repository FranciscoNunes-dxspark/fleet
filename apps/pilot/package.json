{
  "name": "pilot",
  "version": "0.1.0",
  "private": true,
  "description": "An ASP.NET MVC project mapped for Claude Code: controllers, views, layouts, partials, components, bundles, TypeScript, JavaScript and LESS as one graph, asked through a CLI or an MCP server",
  "type": "module",
  "bin": {
    "pilot": "bin/pilot.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node bin/pilot.js",
    "test": "node --import ./src/app.js --test --test-concurrency=3 test/*.test.js",
    "build": "npx --yes bun@1.4.2 ../../packages/kit/scripts/build.js",
    "build:all": "npx --yes bun@1.4.2 ../../packages/kit/scripts/build.js --all"
  },
  "license": "MIT",
  "dependencies": {
    "@fleet/kit": "file:../../packages/kit"
  },
  "fleet": {
    "entry": "bin/pilot.js"
  }
}
