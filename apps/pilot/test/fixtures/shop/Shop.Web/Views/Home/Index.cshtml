@{
    ViewBag.Title = "Home";
}
<section class="hero">
    <h1>Welcome</h1>
</section>
<a class="btn btn-save">x</a>
<div class="info-card">
    <div class="info-card-header">
        <h3 class="info-card-title">@Model.Title</h3>
        <span class="badge">@Model.Count</span>
    </div>
    <div class="info-card-body">
        <p>@Model.Summary</p>
        <a class="info-card-link" href="@Model.Url">More</a>
    </div>
</div>
<img src="/images/logo.png">
<button class="icon-btn"><i class="fa fa-trash"></i></button>
<div class="tip" style="color: #c33; margin-top: 4px">Tip</div>
