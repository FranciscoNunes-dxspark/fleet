{
  "name": "mooring",
  "version": "0.1.0",
  "private": true,
  "description": "Files and shells on a server, in the terminal: an SFTP file manager with two panes and a transfer queue, and a console for commands over SSH, through the system's own ssh and sftp",
  "type": "module",
  "bin": {
    "mooring": "bin/mooring.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node bin/mooring.js",
    "demo": "node bin/mooring.js --demo",
    "test": "node --import @fleet/kit/register.js --import ./src/app.js --test --test-concurrency=3 test/*.test.js",
    "build": "npx --yes bun@1.4.2 ../../packages/kit/scripts/build.js",
    "build:all": "npx --yes bun@1.4.2 ../../packages/kit/scripts/build.js --all"
  },
  "license": "MIT",
  "dependencies": {
    "@fleet/kit": "file:../../packages/kit",
    "ink": "^6.8.0",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "ink-testing-library": "^4.0.0"
  }
}
