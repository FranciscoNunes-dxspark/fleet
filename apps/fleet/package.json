{
  "name": "@fleet/host",
  "version": "0.1.0",
  "private": true,
  "description": "The family's terminal apps in one terminal, switched with ctrl+] like tmux",
  "type": "module",
  "bin": {
    "fleet": "bin/fleet.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node bin/fleet.js",
    "test": "node --import @fleet/kit/register.js --import ./src/app.js --test test/*.test.js",
    "build": "npx --yes bun@1.4.2 ../../packages/kit/scripts/build.js",
    "build:all": "npx --yes bun@1.4.2 ../../packages/kit/scripts/build.js --all"
  },
  "license": "MIT",
  "dependencies": {
    "@fleet/kit": "file:../../packages/kit"
  },
  "fleet": {
    "entry": "src/main.js",
    "includes": ["../splice", "../trawl", "../sonar", "../bosun", "../hail", "../keel"],
    "compile": {
      "autoloadDotenv": false,
      "autoloadBunfig": false
    }
  }
}
