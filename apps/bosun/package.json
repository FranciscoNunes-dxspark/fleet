{
  "name": "bosun",
  "version": "0.1.6",
  "private": true,
  "description": "Runs a project's processes for you in the terminal, each with its own log, port and health",
  "type": "module",
  "bin": {
    "bosun": "bin/bosun.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node bin/bosun.js",
    "test": "node --import @fleet/kit/register.js --import ./src/app.js --test --test-concurrency=3 test/*.test.js",
    "build": "npx --yes bun@1.4.2 ../../packages/kit/scripts/build.js",
    "build:all": "npx --yes bun@1.4.2 ../../packages/kit/scripts/build.js --all"
  },
  "license": "MIT",
  "dependencies": {
    "@fleet/kit": "file:../../packages/kit",
    "ink": "^6.8.0",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "ink-testing-library": "^4.0.0"
  }
}
