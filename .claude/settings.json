{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run test:*)",
      "Bash(npm test -w *)",
      "Bash(npm run build)",
      "Bash(npm ci)",
      "Bash(node .github/scripts/changed.mjs *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show *)",
      "PowerShell(npm test)",
      "PowerShell(npm run test:*)",
      "PowerShell(npm test -w *)",
      "PowerShell(npm run build)",
      "PowerShell(npm ci)",
      "PowerShell(node .github/scripts/changed.mjs *)",
      "PowerShell(git status)",
      "PowerShell(git status *)",
      "PowerShell(git diff)",
      "PowerShell(git diff *)",
      "PowerShell(git log)",
      "PowerShell(git log *)",
      "PowerShell(git show *)"
    ]
  }
}
