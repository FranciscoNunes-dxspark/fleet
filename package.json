{
  "name": "fleet",
  "private": true,
  "description": "The family of keyboard-driven terminal apps (Splice, Trawl, Sonar, Bosun, Hail, Keel, Wharf, Locker, Mooring, Bilge, Chart), Fleet that runs them in one terminal, and the kit they share",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "test:kit": "npm test -w packages/kit",
    "test:splice": "npm test -w apps/splice",
    "test:trawl": "npm test -w apps/trawl",
    "test:sonar": "npm test -w apps/sonar",
    "test:bosun": "npm test -w apps/bosun",
    "test:hail": "npm test -w apps/hail",
    "test:keel": "npm test -w apps/keel",
    "test:wharf": "npm test -w apps/wharf",
    "test:locker": "npm test -w apps/locker",
    "test:mooring": "npm test -w apps/mooring",
    "test:bilge": "npm test -w apps/bilge",
    "test:chart": "npm test -w apps/chart",
    "test:fleet": "npm test -w apps/fleet",
    "build": "npm run build -w apps/keel",
    "start": "npm start -w apps/keel",
    "postinstall": "node scripts/postinstall.js"
  },
  "devDependencies": {
    "patch-package": "^8.0.1"
  },
  "overrides": {
    "@azure/msal-node": "^7.1.1"
  }
}
